{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install --no-audit --no-fund)",
      "Bash(npm ci:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run smoke:*)",
      "Bash(npm run play:*)",
      "Bash(npm run new-scene:*)",
      "Bash(npm run wt:*)",
      "Bash(npm run merge-scene:*)",
      "Bash(node scripts/new-scene.mjs:*)",
      "Bash(node scripts/play.mjs:*)",
      "Bash(agent-browser:*)",
      "Bash(node scripts/shot.mjs:*)",
      "Bash(npm run shot:*)",
      "Bash(node scripts/shot-pw.mjs:*)",
      "Bash(node scripts/merge-scene.mjs:*)",
      "Bash(bash scripts/dev-smoke.sh:*)",
      "Bash(bash scripts/wt.sh list)",
      "Bash(bash scripts/wt.sh new:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git worktree list)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(git push -u origin claude/:*)",
      "Bash(git push -u origin HEAD:claude/:*)",
      "Bash(git restore package-lock.json)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "AGENT_BROWSER_ARGS": "--no-sandbox,--disable-gpu,--disable-crash-reporter,--disable-breakpad"
  },
  "worktree": {
    "baseRef": "head"
  }
}
